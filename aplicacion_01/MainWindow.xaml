<Window x:Class="aplicacion_01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Listar Clientes" Height="500" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#FFF5F5F5" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Buscar cliente por ID"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />
                <WrapPanel>
                    <TextBox x:Name="TxtBuscarId"
                             Width="180"
                             Height="32"
                             Margin="0,0,10,0" />
                    <Button Content="Buscar"
                            Width="100"
                            Height="32"
                            Margin="0,0,10,0"
                            Click="BtnBuscar_Click" />
                    <Button Content="Mostrar todos"
                            Width="120"
                            Height="32"
                            Margin="0,0,10,0"
                            Click="BtnMostrarTodos_Click" />
                    <Button Content="Ir a Productos"
                            Width="120"
                            Height="32"
                            Click="BtnIrProductos_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12">
            <DataGrid x:Name="DgClientes"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding IdCliente}" Width="80" />
                    <DataGridTextColumn Header="Compañía" Binding="{Binding NombreCompania}" Width="180" />
                    <DataGridTextColumn Header="Contacto" Binding="{Binding NombreContacto}" Width="140" />
                    <DataGridTextColumn Header="Cargo" Binding="{Binding CargoContacto}" Width="140" />
                    <DataGridTextColumn Header="Dirección" Binding="{Binding Direccion}" Width="160" />
                    <DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad}" Width="110" />
                    <DataGridTextColumn Header="Región" Binding="{Binding Region}" Width="90" />
                    <DataGridTextColumn Header="CodPostal" Binding="{Binding CodPostal}" Width="90" />
                    <DataGridTextColumn Header="País" Binding="{Binding Pais}" Width="110" />
                    <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="110" />
                    <DataGridTextColumn Header="Fax" Binding="{Binding Fax}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>