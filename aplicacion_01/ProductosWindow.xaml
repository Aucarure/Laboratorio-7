<Window x:Class="aplicacion_01.ProductosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Productos" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Background="#FFF5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Buscar producto (ID o nombre)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                <WrapPanel>
                    <TextBox x:Name="TxtBuscar" Width="220" Height="32" Margin="0,0,10,0" />
                    <Button Content="Buscar" Width="100" Height="32" Margin="0,0,10,0" Click="BtnBuscar_Click" />
                    <Button Content="Mostrar todos" Width="120" Height="32" Click="BtnMostrarTodos_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Datos del producto" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                <WrapPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Nombre" />
                        <TextBox x:Name="TxtNombre" Width="200" Height="28" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Cantidad por unidad" />
                        <TextBox x:Name="TxtCantidad" Width="150" Height="28" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Precio" />
                        <TextBox x:Name="TxtPrecio" Width="90" Height="28" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Stock" />
                        <TextBox x:Name="TxtStock" Width="80" Height="28" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="Categoría" />
                        <TextBox x:Name="TxtCategoria" Width="150" Height="28" />
                    </StackPanel>
                </WrapPanel>
                <WrapPanel>
                    <Button Content="Nuevo" Width="90" Height="32" Margin="0,0,10,0" Click="BtnNuevo_Click" />
                    <Button Content="Guardar" Width="90" Height="32" Margin="0,0,10,0" Click="BtnGuardar_Click" />
                    <Button Content="Eliminar" Width="90" Height="32" Click="BtnEliminar_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12">
            <DataGrid x:Name="DgProductos" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionMode="Single"
                      SelectionChanged="DgProductos_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding IdProducto}" Width="60" />
                    <DataGridTextColumn Header="Nombre" Binding="{Binding NombreProducto}" Width="220" />
                    <DataGridTextColumn Header="Cantidad x unidad" Binding="{Binding CantidadPorUnidad}" Width="150" />
                    <DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnidad}" Width="90" />
                    <DataGridTextColumn Header="Stock" Binding="{Binding UnidadesEnExistencia}" Width="80" />
                    <DataGridTextColumn Header="Categoría" Binding="{Binding CategoriaProducto}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>